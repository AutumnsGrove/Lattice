{
	"name": "@autumnsgrove/lumen-registry",
	"version": "0.1.0",
	"description": "Grove's model registry — model IDs, prices, capabilities, and which model serves which task.",
	"author": "AutumnsGrove",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AutumnsGrove/Lattice.git",
		"directory": "libs/lumen-registry"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./catalog": {
			"types": "./src/catalog.ts",
			"default": "./src/catalog.ts"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
